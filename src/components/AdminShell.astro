---
import Base from "../layouts/Base.astro";
import { Icon } from "astro-icon/components";
import { ROLE_LABEL, type UserRole } from "../lib/users";

interface Props {
  title: string;
  active: "leads" | "users" | "akun";
}

const { title, active } = Astro.props;
const user = Astro.locals.user;
const role = (user?.role ?? "client") as UserRole;

// Navigation is the role boundary made visible: clients never see a link they
// would only be bounced back from by the middleware.
const links = [
  { key: "leads", href: "/admin", label: "Leads", icon: "ph:list-bullets" },
  ...(role === "admin" ? [{ key: "users", href: "/admin/users", label: "Kelola Pengguna", icon: "ph:users-three" }] : []),
  { key: "akun", href: "/admin/akun", label: "Akun Saya", icon: "ph:user-circle" },
];
---

<Base title={title} description="Dashboard Berlin Home Spa">
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <main class="min-h-[100dvh] bg-paper-2">
    <div class="wrap py-8">
      <header class="border-b border-line pb-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <a class="font-display text-xl font-medium tracking-tight text-ink" href="/">Berlin<span class="text-maroon">.</span> Home Spa</a>
            <p class="text-sm text-faint">
              {user?.name} · <span class="text-muted">{ROLE_LABEL[role]}</span>
              {user?.isBootstrap && <span class="text-faint"> (admin utama)</span>}
            </p>
          </div>
          <form method="POST" action="/api/admin/logout">
            <button class="tag cursor-pointer hover:border-maroon hover:text-maroon" type="submit"><Icon name="ph:sign-out" /> Keluar</button>
          </form>
        </div>

        <nav class="mt-4 flex flex-wrap gap-1" aria-label="Menu dashboard">
          {links.map((l) => (
            <a
              href={l.href}
              aria-current={active === l.key ? "page" : undefined}
              class:list={[
                "flex items-center gap-2 border-b-2 px-3 py-2 text-sm transition-colors",
                active === l.key
                  ? "border-maroon font-semibold text-maroon"
                  : "border-transparent text-muted hover:border-line hover:text-ink",
              ]}
            >
              <Icon name={l.icon} /> {l.label}
            </a>
          ))}
        </nav>
      </header>

      <slot />
    </div>
  </main>
</Base>
