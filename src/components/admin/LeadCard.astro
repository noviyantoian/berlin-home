---
import { Icon } from "astro-icon/components";
import { formatLeadTime, formatPhone, telHref, waGreeting, waHref } from "../../lib/leads";
import type { Lead } from "../../lib/schema";

interface Props {
  lead: Lead;
  /** Raw IP is ops-internal, so only admin sessions pass this. */
  showIp?: boolean;
}

const { lead, showIp = false } = Astro.props;

const wa = waHref(lead.phone, waGreeting(lead.name, lead.city));
const tel = telHref(lead.phone);
const phone = formatPhone(lead.phone);

const sourceClass: Record<string, string> = {
  cpc: "bg-blush text-maroon-ink",
  organic: "bg-emerald-50 text-emerald-800",
  social: "bg-indigo-50 text-indigo-800",
  referral: "bg-amber-50 text-amber-800",
  direct: "bg-paper-2 text-muted",
};
---

<li class="border-b border-line/70 p-4 last:border-b-0 sm:px-5 md:grid md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-6">
  <div class="min-w-0">
    <div class="flex items-start justify-between gap-3">
      <h3 class="min-w-0 break-words font-display text-lg leading-snug text-ink md:text-base">{lead.name}</h3>
      <span class={`tag shrink-0 !px-2 !py-0.5 !text-[0.7rem] ${sourceClass[lead.source] || sourceClass.direct}`}>{lead.source}</span>
    </div>

    <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-sm text-muted">
      <span class="inline-flex items-center gap-1"><Icon name="ph:clock" class="text-faint" />{formatLeadTime(lead.createdAt)}</span>
      <span aria-hidden="true" class="text-line">·</span>
      <span class="inline-flex items-center gap-1"><Icon name="ph:map-pin" class="text-faint" />{lead.city}</span>
    </p>

    <p class="mt-1 font-mono text-sm tracking-tight text-ink-soft">{phone}</p>

    {showIp && lead.ip && <p class="mt-1 font-mono text-xs text-faint">IP {lead.ip}</p>}
  </div>

  {wa && tel ? (
    <div class="mt-3 grid grid-cols-2 gap-2 md:mt-0 md:flex md:shrink-0">
      <a class="adm-act adm-act--wa" href={wa} target="_blank" rel="noopener" aria-label={`Chat WhatsApp ${lead.name}`}>
        <Icon name="ph:whatsapp-logo" /> WhatsApp
      </a>
      <a class="adm-act adm-act--call" href={tel} aria-label={`Telepon ${lead.name}`}>
        <Icon name="ph:phone" /> Telepon
      </a>
    </div>
  ) : (
    <p class="mt-3 text-sm text-faint md:mt-0">Nomor tidak valid, tidak bisa dihubungi.</p>
  )}
</li>
