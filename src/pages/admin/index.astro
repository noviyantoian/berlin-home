---
import AdminShell from "../../components/admin/AdminShell.astro";
import LeadCard from "../../components/admin/LeadCard.astro";
import { Icon } from "astro-icon/components";
import { getStats, listLeads, getFraudReport, type Stats, type FraudRow } from "../../lib/leads";

export const prerender = false;

const sp = Astro.url.searchParams;
const f = {
  from: sp.get("from") || undefined,
  to: sp.get("to") || undefined,
  city: sp.get("city") || undefined,
  source: sp.get("source") || undefined,
  q: sp.get("q") || undefined,
  page: Number(sp.get("page") || 1),
  perPage: Number(sp.get("perPage") || 20),
};

// Clients get the lead list only. Fraud scoring and raw IPs are ops-internal,
// so for a client session they are never queried — not merely hidden.
const isAdmin = Astro.locals.user?.role === "admin";
const denied = sp.has("denied");

let stats: Stats | null = null;
let fraud: FraudRow[] = [];
let list: Awaited<ReturnType<typeof listLeads>> | null = null;
let dbError = "";
try {
  [stats, fraud, list] = await Promise.all([
    getStats(),
    isAdmin ? getFraudReport(2) : Promise.resolve([] as FraudRow[]),
    listLeads(f),
  ]);
} catch (e) {
  dbError = (e as Error).message;
}

// IPs worth excluding in Google Ads (suspicious + fraud).
const blocklist = fraud.filter((r) => r.label !== "low").map((r) => r.ip);
const labelClass: Record<string, string> = {
  fraud: "bg-maroon text-white",
  suspicious: "bg-amber-100 text-amber-900",
  low: "bg-paper-2 text-muted",
};
const labelText: Record<string, string> = { fraud: "Fraud", suspicious: "Mencurigakan", low: "Pantau" };

const fmt = new Intl.DateTimeFormat("id-ID", {
  timeZone: "Asia/Makassar", day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit",
});

const pageHref = (p: number) => {
  const u = new URLSearchParams(sp);
  u.set("page", String(p));
  return `/admin?${u.toString()}`;
};
const sources = ["", "cpc", "organic", "social", "referral", "direct"];

// Surfaced in the collapsed filter summary so a phone user never wonders why
// the list looks short.
const activeFilters = [f.q, f.city, f.source, f.from, f.to].filter(Boolean).length;

const statCards = stats
  ? [
      { label: "Chat hari ini", value: stats.today, lead: true },
      { label: "7 hari terakhir", value: stats.last7 },
      { label: "30 hari terakhir", value: stats.last30 },
      { label: "Total leads", value: stats.total },
      { label: "Dari iklan (CPC)", value: stats.cpc },
    ]
  : [];
---

<AdminShell title="Dashboard — Berlin Home Spa" active="leads">
  {denied && (
    <p class="adm-alert adm-alert--err mt-4">Halaman itu khusus admin. Hubungi admin bila kamu memang perlu aksesnya.</p>
  )}

  {dbError && (
    <p class="adm-alert adm-alert--err mt-4">
      Database belum tersambung: {dbError}. Cek <code>DATABASE_URL</code> &amp; jalankan <code>npm run db:push</code>.
    </p>
  )}

  {stats && (
    <section class="mt-4 grid grid-cols-2 gap-2 sm:mt-6 sm:grid-cols-3 sm:gap-3 lg:grid-cols-5" aria-label="Ringkasan">
      {statCards.map((s) => (
        <div class:list={["adm-card p-3 sm:p-4", s.lead && "col-span-2 sm:col-span-1"]}>
          <div class="text-sm text-muted">{s.label}</div>
          <div class:list={["mt-0.5 font-display text-ink", s.lead ? "text-4xl sm:text-3xl" : "text-3xl"]}>{s.value}</div>
        </div>
      ))}
    </section>
  )}

  {isAdmin && (
    <section class="adm-card mt-4 sm:mt-6">
      <details class="adm-fold">
        <summary>
          <span class="flex items-center gap-2"><Icon name="ph:warning" /> Deteksi Fraud Klik (CPC)</span>
          <span class="flex items-center gap-2 text-sm font-normal text-muted">
            {blocklist.length > 0 && <span class="tag !px-2 !py-0.5 !text-[0.7rem] bg-blush text-maroon-ink">{blocklist.length} IP</span>}
            <Icon name="ph:caret-down" class="adm-fold__chev" />
          </span>
        </summary>

        <div class="adm-fold__body p-4 pt-0 sm:p-5">
          <h2 class="hidden items-center gap-2 font-display text-xl text-ink md:flex"><Icon name="ph:warning" /> Deteksi Fraud Klik (CPC)</h2>
          <p class="mt-1 max-w-[70ch] text-sm text-muted">IP berulang dari trafik iklan diberi skor 0–100. Skor ≥ 70 = <strong class="text-maroon-ink">Fraud</strong>, 40–69 = Mencurigakan. Masukkan IP berisiko ke pengecualian IP Google Ads.</p>

          {fraud.length === 0 ? (
            <p class="mt-4 bg-paper-2 px-4 py-3 text-sm text-muted">Belum ada IP berulang dari CPC. Panel terisi otomatis saat pengunjung iklan (ada <code>gclid</code> / <code>utm_medium=cpc</code>) submit form ≥ 2×.</p>
          ) : (
            <>
              <div class="mt-4 overflow-x-auto">
                <table class="w-full min-w-[42rem] border-collapse text-sm">
                  <thead><tr class="border-b border-line text-left text-faint">
                    <th class="py-2 pr-4 font-medium">Skor</th>
                    <th class="py-2 pr-4 font-medium">IP</th>
                    <th class="py-2 pr-4 font-medium">CPC</th>
                    <th class="py-2 pr-4 font-medium">Total</th>
                    <th class="py-2 pr-4 font-medium">1j / 24j</th>
                    <th class="py-2 pr-4 font-medium">Alasan</th>
                    <th class="py-2 font-medium">Terakhir</th>
                  </tr></thead>
                  <tbody>
                    {fraud.map((r) => (
                      <tr class="border-b border-line/60">
                        <td class="py-2 pr-4"><span class={`inline-block rounded-full px-2.5 py-1 text-xs font-bold ${labelClass[r.label]}`}>{r.score} · {labelText[r.label]}</span></td>
                        <td class="py-2 pr-4 font-mono">{r.ip}</td>
                        <td class="py-2 pr-4 font-semibold text-maroon">{r.cpc}</td>
                        <td class="py-2 pr-4">{r.total}</td>
                        <td class="py-2 pr-4">{r.last1h} / {r.last24h}</td>
                        <td class="py-2 pr-4 text-xs text-muted">{r.reasons.join(" · ")}</td>
                        <td class="py-2 whitespace-nowrap text-muted">{fmt.format(new Date(r.lastSeen))}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {blocklist.length > 0 && (
                <div class="mt-5 border-t border-line pt-4">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <h3 class="text-sm font-semibold">Blocklist Google Ads · {blocklist.length} IP</h3>
                    <button id="copy-blocklist" type="button" class="adm-act adm-act--sm">Salin semua</button>
                  </div>
                  <pre id="blocklist-text" class="mt-2 max-h-48 overflow-auto whitespace-pre-wrap break-all bg-paper-2 p-3 font-mono text-xs">{blocklist.join("\n")}</pre>
                  <p class="mt-1 text-xs text-faint">Google Ads → Setelan kampanye → Pengecualian IP. Maks 500 IP per kampanye.</p>
                </div>
              )}
            </>
          )}
        </div>
      </details>
    </section>
  )}

  <script is:inline>
    document.getElementById("copy-blocklist")?.addEventListener("click", async () => {
      const el = document.getElementById("blocklist-text");
      const btn = document.getElementById("copy-blocklist");
      if (!el || !btn) return;
      try {
        await navigator.clipboard.writeText(el.textContent || "");
        const o = btn.textContent;
        btn.textContent = "Tersalin";
        setTimeout(() => { btn.textContent = o; }, 1500);
      } catch (e) { /* clipboard blocked */ }
    });
  </script>

  <section class="adm-card mt-4 sm:mt-6">
    <details class="adm-fold border-b border-line">
      <summary>
        <span class="flex items-center gap-2"><Icon name="ph:funnel" /> Filter &amp; cari</span>
        <span class="flex items-center gap-2 text-sm font-normal text-muted">
          {activeFilters > 0 && <span class="tag !px-2 !py-0.5 !text-[0.7rem] bg-blush text-maroon-ink">{activeFilters} aktif</span>}
          <Icon name="ph:caret-down" class="adm-fold__chev" />
        </span>
      </summary>

      <div class="adm-fold__body p-4 pt-0 md:pt-4">
        <form method="GET" action="/admin" class="grid gap-3 sm:grid-cols-2 md:flex md:flex-wrap md:items-end">
          <div class="grid gap-1 sm:col-span-2 md:w-52"><label class="text-xs text-faint" for="q">Cari nama/HP</label><input class="adm-in" id="q" name="q" value={f.q} placeholder="nama / nomor" /></div>
          <div class="grid gap-1 md:w-40"><label class="text-xs text-faint" for="city">Kota</label><input class="adm-in" id="city" name="city" value={f.city} placeholder="kota" /></div>
          <div class="grid gap-1 md:w-36"><label class="text-xs text-faint" for="source">Source</label>
            <select class="adm-in" id="source" name="source">
              {sources.map((s) => <option value={s} selected={f.source === s}>{s === "" ? "Semua" : s}</option>)}
            </select>
          </div>
          <div class="grid gap-1 md:w-40"><label class="text-xs text-faint" for="from">Dari</label><input class="adm-in" id="from" name="from" type="date" value={f.from} /></div>
          <div class="grid gap-1 md:w-40"><label class="text-xs text-faint" for="to">Sampai</label><input class="adm-in" id="to" name="to" type="date" value={f.to} /></div>
          <div class="grid grid-cols-2 gap-2 sm:col-span-2 md:flex md:w-auto">
            <button class="adm-act adm-act--call" type="submit">Terapkan</button>
            <a class="adm-act" href="/admin">Reset</a>
          </div>
        </form>
      </div>
    </details>

    {list && (
      <p class="border-b border-line px-4 py-3 text-sm text-muted sm:px-5">
        <strong class="font-semibold text-ink">{list.total}</strong> lead
        {activeFilters > 0 && " (terfilter)"} · halaman {list.page} dari {list.pages}
      </p>
    )}

    {list && list.rows.length === 0 ? (
      <p class="px-4 py-10 text-center text-faint sm:px-5">Belum ada lead.</p>
    ) : (
      <ul class="list-none">
        {list?.rows.map((l) => <LeadCard lead={l} showIp={isAdmin} />)}
      </ul>
    )}

    {list && list.pages > 1 && (
      <div class="grid grid-cols-2 gap-2 border-t border-line p-4 sm:px-5">
        <a class:list={["adm-act", list.page <= 1 && "pointer-events-none opacity-40"]} href={pageHref(list.page - 1)} rel="prev">
          <Icon name="ph:caret-left" /> Sebelumnya
        </a>
        <a class:list={["adm-act", list.page >= list.pages && "pointer-events-none opacity-40"]} href={pageHref(list.page + 1)} rel="next">
          Berikutnya <Icon name="ph:caret-right" />
        </a>
      </div>
    )}
  </section>
</AdminShell>
