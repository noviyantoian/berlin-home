---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrustMarquee from "../components/TrustMarquee.astro";
import Services from "../components/Services.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Features from "../components/Features.astro";
import Testimonials from "../components/Testimonials.astro";
import Area from "../components/Area.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import WaFab from "../components/WaFab.astro";
import LeadModal from "../components/LeadModal.astro";
import { faqs } from "../data/site";

const title = "Pijat Panggilan Bali 24 Jam · Massage & Spa ke Lokasi Anda";
const description =
  "Pijat, massage & spa panggilan 24 jam di seluruh Bali. Terapis bersertifikat datang ke rumah, hotel & villa Anda — Denpasar, Seminyak, Canggu, Kuta, Sanur, Ubud. Gratis transport, pesan via WhatsApp.";

const areaCities = [
  "Denpasar", "Seminyak", "Canggu", "Kuta", "Legian",
  "Sanur", "Jimbaran", "Nusa Dua", "Uluwatu", "Kerobokan", "Ubud",
];

// One JSON-LD @graph: the local business + a FAQPage generated from the same
// `faqs` used on the page (single source of truth, no content drift).
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HealthAndBeautyBusiness",
      "@id": "https://berlinhomespa.com/#business",
      name: "Berlin Home Spa & Reflexology",
      description:
        "Layanan pijat, massage & spa panggilan (outcall) 24 jam oleh terapis bersertifikat di seluruh Bali — datang ke rumah, hotel, villa, dan apartemen Anda.",
      image: "https://berlinhomespa.com/assets/images/og.jpg",
      url: "https://berlinhomespa.com/",
      telephone: "+6282333078188",
      priceRange: "$$",
      currenciesAccepted: "IDR",
      areaServed: [
        { "@type": "AdministrativeArea", name: "Bali" },
        ...areaCities.map((name) => ({ "@type": "City", name })),
      ],
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        opens: "00:00",
        closes: "23:59",
      },
      makesOffer: [
        { "@type": "Offer", itemOffered: { "@type": "Service", name: "Pijat Tradisional Full Body" } },
        { "@type": "Offer", itemOffered: { "@type": "Service", name: "Full Body & Vitalitas" } },
        { "@type": "Offer", itemOffered: { "@type": "Service", name: "Full Body & Lulur Scrub" } },
        { "@type": "Offer", itemOffered: { "@type": "Service", name: "Refleksi & Full Body" } },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://berlinhomespa.com/#faq",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
});
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <link slot="head" rel="preload" as="image" href="/assets/images/hero-portrait.webp" fetchpriority="high" />
  <Header />
  <main id="top">
    <Hero />
    <TrustMarquee />
    <Services />
    <HowItWorks />
    <Features />
    <Testimonials />
    <Area />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <WaFab />
  <LeadModal />
</Base>
